{
  "name": "docker-wordpress-dev",
  "version": "2.0.2",
  "private": true,
  "description": "Docker-based local development environment for WordPress projects",
  "repository": "https://github.com/ideasonpurpose/docker-wordpress-dev",
  "license": "MIT",
  "author": "Ideas On Purpose (https://www.ideasonpurpose.com/)",
  "contributors": [
    "Joe Maller <joe@ideasonpurpose.com>"
  ],
  "scripts": {
    "bump": "pnpm run wordpress:bump",
    "shfmt": "docker compose run --rm shfmt",
    "version": "version-everything && git add -u",
    "wordpress:bump": "docker compose run --rm bump-wp"
  },
  "prettier": "@ideasonpurpose/prettier-config",
  "devDependencies": {
    "@ideasonpurpose/prettier-config": "^1.1.1",
    "@prettier/plugin-php": "^0.25.0",
    "prettier": "^3.9.8",
    "version-everything": "^0.12.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.5.1",
      "onFail": "error"
    }
  },
  "version-everything": {
    "files": [
      "bin/docker-entrypoint-iop.sh",
      "bin/permissions.sh",
      "bin/pull.sh",
      "Dockerfile",
      "README.md"
    ]
  }
}
